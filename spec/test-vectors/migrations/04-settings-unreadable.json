{
  "name": "04-settings-unreadable",
  "description": "Unparseable file, or a schema that is not a non-negative integer: boot does not write (the firmware uses defaults or reads what it can). A save writes a fresh file (invalid) or replaces the schema in place (unknown).",
  "cases": [
    { "name": "truncated JSON", "op": "migrate", "raw": "{\"brightness\": 3", "expect": { "status": "invalid", "from": -1, "version": -1 } },
    { "name": "array", "op": "migrate", "raw": "[1,2]", "expect": { "status": "invalid", "from": -1, "version": -1 } },
    { "name": "schema is a string", "op": "migrate", "stored": { "schema": "2", "clock": "12" }, "expect": { "status": "unknown", "from": -1, "version": -1, "output": { "schema": "2", "clock": "12" } } },
    { "name": "schema is a fraction", "op": "migrate", "stored": { "schema": 1.5 }, "expect": { "status": "unknown", "from": -1, "version": -1 } },
    { "name": "schema is negative", "op": "migrate", "stored": { "schema": -1 }, "expect": { "status": "unknown", "from": -1, "version": -1 } },
    {
      "name": "save over truncated JSON: fresh file",
      "op": "persist", "raw": "{\"brightness\": 3", "known": { "brightness": 50 },
      "expect": { "output": { "schema": 2, "brightness": 50 } }
    },
    {
      "name": "save over unknown schema: schema replaced in place, other keys kept",
      "op": "persist", "stored": { "clock": "12", "schema": "2", "x": 1 }, "known": { "clock": "24" },
      "expect": { "output": { "clock": "24", "schema": 2, "x": 1 } }
    }
  ]
}
