{
  "description": "Device health as Home Assistant entities (#32; emulator src/core/haReport.ts, firmware core/ha_report.h). states: what one push POSTs to /api/states/<entity_id>, in order (attribute order too). due: whether to push now. Times in ms since boot; epochs in seconds; an epoch before 1700000000 means the clock is not set.",
  "states": [
    {
      "name": "everything known, charging from USB",
      "input": { "hostname": "ha-paper-a1b2.local", "name": "Hallway", "battery": 64, "charging": true, "usb": true, "rssi": -61, "firmware": "0.2.0-beta.1", "resetReason": "POWERON", "lastFullEpoch": 1760600000, "bootEpoch": 1760599000 },
      "expect": [
        { "entity_id": "sensor.ha_paper_a1b2_battery", "state": "64", "attributes": { "friendly_name": "Hallway battery", "unit_of_measurement": "%", "device_class": "battery", "state_class": "measurement" } },
        { "entity_id": "binary_sensor.ha_paper_a1b2_charging", "state": "on", "attributes": { "friendly_name": "Hallway charging", "device_class": "battery_charging", "source": "usb" } },
        { "entity_id": "sensor.ha_paper_a1b2_wifi_signal", "state": "-61", "attributes": { "friendly_name": "Hallway Wi-Fi signal", "unit_of_measurement": "dBm", "device_class": "signal_strength", "state_class": "measurement" } },
        { "entity_id": "sensor.ha_paper_a1b2_last_full_refresh", "state": "2025-10-16T07:33:20+00:00", "attributes": { "friendly_name": "Hallway last full refresh", "device_class": "timestamp" } },
        { "entity_id": "sensor.ha_paper_a1b2_last_boot", "state": "2025-10-16T07:16:40+00:00", "attributes": { "friendly_name": "Hallway last boot", "device_class": "timestamp" } },
        { "entity_id": "sensor.ha_paper_a1b2_firmware", "state": "0.2.0-beta.1", "attributes": { "friendly_name": "Hallway firmware" } },
        { "entity_id": "sensor.ha_paper_a1b2_reset_reason", "state": "POWERON", "attributes": { "friendly_name": "Hallway reset reason" } }
      ]
    },
    {
      "name": "no clock, no Wi-Fi reading (QEMU Ethernet), full on USB: not charging, source usb, hostname without .local",
      "input": { "hostname": "ha-paper-00ff", "name": "Living room display", "battery": 100, "charging": false, "usb": true, "rssi": null, "firmware": "0.0.0-dev", "resetReason": "TASK_WDT", "lastFullEpoch": 1000, "bootEpoch": null },
      "expect": [
        { "entity_id": "sensor.ha_paper_00ff_battery", "state": "100", "attributes": { "friendly_name": "Living room display battery", "unit_of_measurement": "%", "device_class": "battery", "state_class": "measurement" } },
        { "entity_id": "binary_sensor.ha_paper_00ff_charging", "state": "off", "attributes": { "friendly_name": "Living room display charging", "device_class": "battery_charging", "source": "usb" } },
        { "entity_id": "sensor.ha_paper_00ff_firmware", "state": "0.0.0-dev", "attributes": { "friendly_name": "Living room display firmware" } },
        { "entity_id": "sensor.ha_paper_00ff_reset_reason", "state": "TASK_WDT", "attributes": { "friendly_name": "Living room display reset reason" } }
      ]
    }
  ],
  "due": [
    { "name": "never pushed this boot", "last": null, "force": false, "nowMs": 5000, "battery": 50, "charging": false, "expect": true },
    { "name": "reconnected 30 s after a push: wait", "last": { "atMs": 100000, "battery": 50, "charging": false }, "force": true, "nowMs": 130000, "battery": 50, "charging": false, "expect": false },
    { "name": "reconnected 60 s after a push", "last": { "atMs": 100000, "battery": 50, "charging": false }, "force": true, "nowMs": 160000, "battery": 50, "charging": false, "expect": true },
    { "name": "nothing changed, 9 min", "last": { "atMs": 100000, "battery": 50, "charging": false }, "force": false, "nowMs": 640000, "battery": 50, "charging": false, "expect": false },
    { "name": "nothing changed, 10 min", "last": { "atMs": 100000, "battery": 50, "charging": false }, "force": false, "nowMs": 700000, "battery": 50, "charging": false, "expect": true },
    { "name": "battery down 1 % after 2 min", "last": { "atMs": 100000, "battery": 50, "charging": false }, "force": false, "nowMs": 220000, "battery": 49, "charging": false, "expect": true },
    { "name": "battery down 1 % after 20 s: rate limit", "last": { "atMs": 100000, "battery": 50, "charging": false }, "force": false, "nowMs": 120000, "battery": 49, "charging": false, "expect": false },
    { "name": "network failure 10 s ago: one early retry", "last": { "atMs": 100000, "battery": 50, "charging": false, "retry": true }, "force": true, "nowMs": 110000, "battery": 50, "charging": false, "expect": true },
    { "name": "network failure 9 s ago: wait", "last": { "atMs": 100000, "battery": 50, "charging": false, "retry": true }, "force": true, "nowMs": 109000, "battery": 50, "charging": false, "expect": false },
    { "name": "early retry failed too: back to the 60 s gap", "last": { "atMs": 100000, "battery": 50, "charging": false, "retry": false }, "force": true, "nowMs": 110000, "battery": 50, "charging": false, "expect": false },
    { "name": "charger plugged in after 61 s", "last": { "atMs": 100000, "battery": 50, "charging": false }, "force": false, "nowMs": 161000, "battery": 50, "charging": true, "expect": true }
  ]
}
