      ],
      "boots": [
        {
          "reason": "POWERON",
          "crash": false,
          "version": "0.3.0",
          "uptime_s": 0,
          "min_free_heap": 0,
          "panic": null,
          "last_seen": null
        }
      ],
      "last_crash": null
    },
