{
  "name": "07-quiet-end",
  "description": "Quiet hours (#295, every power saving mode but Always live): sleep until the window ends, never longer than 8 h; no timer wakes inside it. Peeking (a press in the window: dashboard for 60 s) keeps it awake.",
  "base": {
    "nowEpoch": 1800000000,
    "localSec": 43200,
    "powerSave": "standby",
    "wakeEvery": 15,
    "quiet": "23-07",
    "peeking": false,
    "standby": true,
    "charging": false,
    "usb": false,
    "chargedAgoMin": null,
    "voltage": 3.9,
    "battery": 60,
    "otaPendingVerify": false,
    "otaBusy": false,
    "otaAuto": "notify",
    "otaDue": false,
    "setup": false,
    "msSinceApi": null
  },
  "cases": [
    {
      "name": "23:30, 23-07: wake at 07:00",
      "input": {
        "powerSave": "standby",
        "standby": false,
        "localSec": 84600
      },
      "expect": {
        "deepSleepNow": true,
        "wakeAtEpoch": 1800027000,
        "buttonWakeOnly": false,
        "reason": "quiet"
      }
    },
    {
      "name": "glance at 23:30, 23-07: wake at 07:00, not every 15 min",
      "input": {
        "powerSave": "glance",
        "standby": false,
        "localSec": 84600
      },
      "expect": {
        "deepSleepNow": true,
        "wakeAtEpoch": 1800027000,
        "buttonWakeOnly": false,
        "reason": "quiet"
      }
    },
    {
      "name": "22:00, 22-06: exactly 8 h",
      "input": {
        "powerSave": "standby",
        "standby": false,
        "quiet": "22-06",
        "localSec": 79200
      },
      "expect": {
        "deepSleepNow": true,
        "wakeAtEpoch": 1800028800,
        "buttonWakeOnly": false,
        "reason": "quiet"
      }
    },
    {
      "name": "22:00, 22-07: capped at 8 h",
      "input": {
        "powerSave": "standby",
        "standby": false,
        "quiet": "22-07",
        "localSec": 79200
      },
      "expect": {
        "deepSleepNow": true,
        "wakeAtEpoch": 1800028800,
        "buttonWakeOnly": false,
        "reason": "quiet"
      }
    },
    {
      "name": "05:59:30, 00-06: 30 s",
      "input": {
        "powerSave": "standby",
        "standby": false,
        "quiet": "00-06",
        "localSec": 21570
      },
      "expect": {
        "deepSleepNow": true,
        "wakeAtEpoch": 1800000030,
        "buttonWakeOnly": false,
        "reason": "quiet"
      }
    },
    {
      "name": "peeking at the dashboard in quiet hours",
      "input": {
        "powerSave": "standby",
        "standby": false,
        "peeking": true,
        "localSec": 3600
      },
      "expect": {
        "deepSleepNow": false,
        "wakeAtEpoch": null,
        "reason": "awake"
      }
    },
    {
      "name": "Standby mode, standby face off, by day: awake",
      "input": {
        "powerSave": "standby",
        "standby": false
      },
      "expect": {
        "deepSleepNow": false,
        "wakeAtEpoch": null,
        "reason": "awake"
      }
    },
    {
      "name": "power saving off in quiet hours",
      "input": {
        "powerSave": "off",
        "localSec": 3600
      },
      "expect": {
        "deepSleepNow": false,
        "wakeAtEpoch": null,
        "reason": "power save off",
        "cpuProfile": "auto",
        "wifiPs": "min"
      }
    },
    {
      "name": "quiet hours off",
      "input": {
        "powerSave": "standby",
        "quiet": "off",
        "localSec": 3600,
        "standby": false
      },
      "expect": {
        "deepSleepNow": false,
        "wakeAtEpoch": null,
        "reason": "awake"
      }
    }
  ]
}
