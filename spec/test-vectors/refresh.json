{
  "description": "E-ink clean-up policy (SPEC §7, issues #26, #197, #212). Times are epoch minutes; 29864940 = Tue 13 Oct 2026 13:00 UTC. Kinds: partial (window), fast (whole frame, no flash, B/W only since #212 with grays thresholded like a partial: navigation), clean (one short flash), full (multi-flash, manual only). A partial never forces a clean while the clock is known; without a clock, 30 partials or fast refreshes do ('ghosting limit'). A navigation is fast; the 10th since the last clean is a clean ('nav clean'), and a clean resets both counters. The scheduled clean runs at the first :00/:30 at least everyMin (display.cleanEvery: 30, 60, 120) after the last clean, only with partial or fast refreshes (data, clock, tap feedback, navigation) since, and never while night mode is active (standby keeps it). Standby/night skips of non-clock redraws live in firmware App::commit. input (#212): of the events polled in one loop pass (all queued while the last refresh ran) only the last is handled; expect = its index, -1 for none.",
  "partial": [
    { "name": "clock known: no cap", "input": { "reason": "HA update", "sleeping": false, "night": false, "sinceFull": 100, "clockKnown": true }, "expect": { "kind": "partial", "sinceFull": 101 } },
    { "name": "clock unset: below cap", "input": { "reason": "HA update", "sleeping": false, "night": false, "sinceFull": 28, "clockKnown": false }, "expect": { "kind": "partial", "sinceFull": 29 } },
    { "name": "clock unset: 30th partial is a full", "input": { "reason": "HA update", "sleeping": false, "night": false, "sinceFull": 29, "clockKnown": false }, "expect": { "kind": "clean", "reason": "ghosting limit" } },
    { "name": "standby: data skipped", "input": { "reason": "HA update", "sleeping": true, "night": false, "sinceFull": 0, "clockKnown": true }, "expect": { "kind": "skip", "why": "standby" } },
    { "name": "night: data skipped", "input": { "reason": "HA update", "sleeping": false, "night": true, "sinceFull": 0, "clockKnown": true }, "expect": { "kind": "skip", "why": "night" } },
    { "name": "night: clock still drawn", "input": { "reason": "clock", "sleeping": false, "night": true, "sinceFull": 3, "clockKnown": true }, "expect": { "kind": "partial", "sinceFull": 4 } }
  ],
