# Matches the existing code; no reformatting implied. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python (firmware/scripts, firmware/tools) and the vendored-style C driver under sim/qemu/lib
[*.{py,c}]
indent_size = 4

[{Makefile,*.mk,.gitmodules}]
indent_style = tab

