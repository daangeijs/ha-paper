{
  "name": "ha-paper-emulator",
  "private": true,
  "license": "MIT",
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:device-ui": "vite build --config vite.device-ui.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "vectors": "node scripts/gen-vectors.ts",
    "device-sim": "node server/main.ts",
    "fake-ha": "node server/fake-ha-main.ts",
    "test:contract": "vitest run server/",
    "lint": "biome lint ."
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
